---
// src/components/NavBar.astro
import { normalizePathname, withBase } from "../scripts/paths";

const pathname = normalizePathname(Astro.url.pathname);
const homeHref = withBase("/");
const links = [
  { href: homeHref,                  label: 'خانه' },
  { href: withBase('/ai/'),          label: 'هوش مصنوعی' },
  { href: withBase('/miniature/'),   label: 'نگارگری' },
  { href: withBase('/graphic/'),     label: 'گرافیک' },
  { href: withBase('/other/'),       label: 'سایر' },
  { href: withBase('/about/'),       label: 'دربارهٔ من' },
  { href: withBase('/contact/'),     label: 'تماس' },
];
---
<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href={homeHref}>نگین خسرویانی</a>
    <nav class="site-nav" aria-label="منوی اصلی">
      <ul>
        {links.slice(1).map((l) => {
          const normalizedHref = normalizePathname(l.href);
          const isActive = pathname === normalizedHref || pathname.startsWith(`${normalizedHref}/`);
          return (
            <li>
              <a href={l.href} aria-current={isActive ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--page-bg);
    border-bottom: 1px solid var(--hairline);
  }

  .site-header__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.5rem var(--page-gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .site-header__brand {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: 0;
  }

  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }

  .site-nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 400;
    padding: 0.25rem 0;
    transition: color 0.15s ease;
  }

  .site-nav a:hover { color: var(--ink); }

  .site-nav a[aria-current="page"] {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  @media (max-width: 640px) {
    .site-header__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
      padding: 1.25rem var(--page-gutter);
    }
    .site-nav ul {
      gap: 0.25rem 1.1rem;
    }
    .site-nav a { font-size: 0.9rem; }
  }
</style>
