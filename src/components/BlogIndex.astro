---
import Layout from '../layouts/Layout.astro';
const {posts,lang='fa'}=Astro.props;const en=lang==='en';const title=en?'Persian Art Blog | Negin Khosraviyani':'وبلاگ نگین خسرویانی | هنر ایرانی و تصویرسازی';
---
<Layout lang={lang} title={title} description={en?'Articles on Persian illumination, Gol-o-Morgh, Eslimi ornament, illustration and art materials by Negin Khosraviyani.':'نوشته‌های نگین خسرویانی دربارهٔ تذهیب، گل و مرغ، اسلیمی، تصویرسازی و ابزار هنری.'} languageAlternates={{fa:'/blog/',en:'/en/blog/'}}><section class="blog"><h1>{en?'Art and Illustration Blog':'وبلاگ نگین خسرویانی'}</h1><p>{en?'Writing and research on Persian art, illustration and design.':'نوشته‌ها و پژوهش‌های هنر ایرانی، تصویرسازی و طراحی.'}</p>{posts.map(post=><article><a href={en?'/en/blog/'+post.enSlug+'/':'/'+post.slug+'/'}><h2>{post.title}</h2></a><p>{post.description}</p><a href={en?'/en/blog/'+post.enSlug+'/':'/'+post.slug+'/'}>{en?'Read article →':'خواندن نوشته ←'}</a></article>)}</section></Layout>
<style>.blog{max-width:48rem;margin:auto;line-height:1.9}.blog article{padding:1.5rem 0;border-bottom:1px solid var(--hairline)}h2{font-size:1.3rem}</style>