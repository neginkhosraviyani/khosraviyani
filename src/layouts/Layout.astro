---
// src/layouts/Layout.astro
import social from "../content/social.json";
import NavBar from "../components/Navbar.astro";
import { withBase } from "../scripts/paths";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  lang?: 'fa' | 'en';
  languageAlternates?: { fa: string; en: string };
}

const SITE_TITLE = "نگین خسرویانی | نگارگری، طراحی گرافیک و هنر دیجیتال";
const SITE_DESCRIPTION = "پورتفولیوی نگین خسرویانی — هوش مصنوعی، موشن گرافیک، گرافیک، آثار هنری، نمایشگاه‌ها، افتخارات.";

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  ogImage,
  lang = 'fa',
  languageAlternates,
} = Astro.props;

const dir = lang === 'fa' ? 'rtl' : 'ltr';

const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;

const defaultOgImage = Astro.site
  ? new URL(withBase('/og-default.png'), Astro.site).href
  : withBase('/og-default.png');
const resolvedOgImage = ogImage || defaultOgImage;
const rootUrl = Astro.site?.href || 'https://khosraviyani.ir/';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person', '@id': rootUrl + '#artist',
      name: 'نگین خسرویانی', alternateName: 'Negin Khosraviyani',
      url: rootUrl, jobTitle: 'هنرمند و طراح گرافیک',
      sameAs: [social.linkedin, social.youtube, social.telegram].filter(Boolean)
    },
    {
      '@type': 'WebSite', '@id': rootUrl + '#website',
      name: 'نگین خسرویانی', alternateName: 'Negin Khosraviyani',
      url: rootUrl, inLanguage: lang, publisher: { '@id': rootUrl + '#artist' }
    },
    {
      '@type': 'WebPage', '@id': canonicalUrl + '#webpage',
      url: canonicalUrl, name: title, description, inLanguage: lang,
      isPartOf: { '@id': rootUrl + '#website' },
      about: { '@id': rootUrl + '#artist' }
    }
  ]
};
const serializedStructuredData = JSON.stringify(structuredData).replace(/</g, '\\u003c');
---
<!DOCTYPE html>
<html lang={lang} dir={dir} data-translated-page={languageAlternates ? lang : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FFFFFF" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta name="robots" content="max-image-preview:large" />
    <meta property="og:locale" content={lang === 'fa' ? 'fa_IR' : 'en_US'} />
    <meta property="og:site_name" content="نگین خسرویانی" />
    <script is:inline type="application/ld+json" set:html={serializedStructuredData} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <link rel="canonical" href={canonicalUrl} />
    {languageAlternates && <>
      <link rel="alternate" hreflang="fa" href={new URL(languageAlternates.fa, Astro.site)} />
      <link rel="alternate" hreflang="en" href={new URL(languageAlternates.en, Astro.site)} />
      <link rel="alternate" hreflang="x-default" href={new URL(languageAlternates.fa, Astro.site)} />
    </>}
    <link rel="icon" href={withBase("/favicon.svg")} />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-XMSGEYHC6X"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XMSGEYHC6X');
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{lang === 'en' ? 'Skip to content' : 'رفتن به محتوا'}</a>
    <NavBar lang={lang} languageAlternates={languageAlternates} />
    <main id="main" class="page-shell">
      <slot />
    </main>
  </body>
</html>

