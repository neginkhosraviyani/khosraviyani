---
// src/layouts/Layout.astro
import NavBar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { withBase } from "../scripts/paths";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  lang?: 'fa' | 'en';
}

const SITE_TITLE = "نگین خسرویانی";
const SITE_DESCRIPTION = "پورتفولیوی نگین خسرویانی — هوش مصنوعی، نگارگری و گل و مرغ، طراحی گرافیک و آثار دیگر.";

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  ogImage,
  lang = 'fa',
} = Astro.props;

const dir = lang === 'fa' ? 'rtl' : 'ltr';

const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;

const defaultOgImage = Astro.site
  ? new URL(withBase('/og-default.png'), Astro.site).href
  : withBase('/og-default.png');
const resolvedOgImage = ogImage || defaultOgImage;
---
<!DOCTYPE html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FFFFFF" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={withBase("/favicon.svg")} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">رفتن به محتوا</a>
    <NavBar />
    <main id="main" class="container">
      <slot />
    </main>
    <Footer />
  </body>
</html>
