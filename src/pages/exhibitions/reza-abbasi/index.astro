---
import Layout from "../../../layouts/Layout.astro";
import { getAlbums, resolveAlbumMediaUrls } from '../../../scripts/content';

const albumsRaw = getAlbums('exhibition-rezaabbasi');
const albums = await Promise.all(albumsRaw.map((a) => resolveAlbumMediaUrls('exhibition-rezaabbasi', a.slug, a)));

const allImages = albums.flatMap((a) =>
  (a.placeholder?.enabled ? [] : a.media.filter((m: any) => m.type === 'image'))
);
const isAllPlaceholder = albums.length > 0 && albums.every((a) => a.placeholder?.enabled);
---

<Layout title="موزه رضا عباسی تهران — نگین خسرویانی" description="نمایشگاه در موزه رضا عباسی تهران.">
  <section class="page-header"><h1 class="page-header__title">موزه رضا عباسی تهران</h1></section>

  {isAllPlaceholder ? (
    <p class="project__placeholder">گزارش این نمایشگاه در دست تهیه است و به‌زودی منتشر می‌شود.</p>
  ) : (
    <div class="project__media">
      {allImages.map((m: any) => (
        <figure class="project__figure">
          <picture>
            {m.webpSrc && <source type="image/webp" srcset={m.webpSrc} />}
            <img src={m.src} alt={m.alt ?? 'موزه رضا عباسی تهران'} loading="lazy" decoding="async" />
          </picture>
          {m.caption && <figcaption>{m.caption}</figcaption>}
        </figure>
      ))}
    </div>
  )}
</Layout>
