---
// src/pages/about.astro
import Layout from "../layouts/Layout.astro";
import { withBase } from "../scripts/paths";
import social from "../content/social.json";

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "نگین خسرویانی",
  "url": Astro.site?.href,
  "jobTitle": "Artist",
  "sameAs": [social.linkedin, social.github].filter(Boolean),
};
---

<Layout
  title="دربارهٔ من — نگین خسرویانی"
  description="معرفی نگین خسرویانی، هنرمند چندرشته‌ای در حوزهٔ هوش مصنوعی، نگارگری ایرانی، گل و مرغ و طراحی گرافیک."
>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(personJsonLd)} />
  <article class="about">
    <div class="about__content">
      <header class="about__header">
        <p class="about__eyebrow">دربارهٔ من</p>
        <h1 class="about__name">نگین خسرویانی</h1>
      </header>

      <section class="about__statement" aria-label="معرفی">
        <p>
          هنرمندی چندرشته‌ای که میان سنت و فناوری، میان نگارگری ایرانی و هوش مصنوعی،
          و میان زبان گل و مرغ و طراحی گرافیک معاصر در حرکت است.
        </p>
        <p>
          این پورتفولیو در حال شکل‌گیری است و به‌زودی با آثار کامل از هر چهار بخش
          به‌روزرسانی می‌شود. تا آن زمان، کارت‌های مجموعه به‌صورت زمان‌بند نگه‌داشته شده‌اند.
        </p>
      </section>

      <nav class="about__work-links" aria-label="مشاهدهٔ آثار بر اساس بخش">
        <h2 class="about__section-label">آثار</h2>
        <ul class="about__list about__list--links">
          <li><a href={withBase('/ai/')}>هوش مصنوعی</a></li>
          <li><a href={withBase('/miniature/')}>نگارگری و گل و مرغ</a></li>
          <li><a href={withBase('/graphic/')}>گرافیک</a></li>
          <li><a href={withBase('/other/')}>سایر</a></li>
        </ul>
      </nav>
    </div>
  </article>
</Layout>

<style>
  .about {
    max-width: 44rem;
    padding-top: clamp(2rem, 6vh, 4rem);
    padding-bottom: 6rem;
  }

  .about__header {
    margin-bottom: clamp(2rem, 5vh, 3rem);
  }

  .about__eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    color: color-mix(in oklab, #1B1B1B 55%, transparent);
  }

  .about__name {
    margin: 0;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 700;
    color: #1B1B1B;
  }

  .about__statement {
    margin-bottom: clamp(2.5rem, 6vh, 4rem);
  }

  .about__statement p {
    margin: 0 0 1.4em;
    font-size: clamp(1rem, 1.8vw, 1.1rem);
    line-height: 1.9;
    color: color-mix(in oklab, #1B1B1B 80%, transparent);
    max-width: 38rem;
  }

  .about__section-label {
    margin: 0 0 1rem;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    color: color-mix(in oklab, #1B1B1B 50%, transparent);
    font-weight: 500;
  }

  .about__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .about__list--links a {
    color: color-mix(in oklab, #1B1B1B 78%, transparent);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in oklab, #1B1B1B 22%, transparent);
    padding-bottom: 1px;
    transition: color 0.18s ease, border-color 0.18s ease;
  }

  .about__list--links a:hover {
    color: #1B1B1B;
    border-color: #1B1B1B;
  }
</style>
