---
// src/pages/about.astro
import Layout from "../layouts/Layout.astro";
import { withBase } from "../scripts/paths";
import social from "../content/social.json";

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Negin Khosraviyani",
  "url": Astro.site?.href,
  "jobTitle": "Artist",
  "alumniOf": "University of Tehran",
  "knowsAbout": [
    "Persian Miniature Painting",
    "Negargari",
    "Graphic Design",
    "Artificial Intelligence Art",
    "Zoroastrian Embroidery"
  ],
  "sameAs": [(social as any).linkedin, (social as any).instagram, (social as any).github].filter(Boolean),
};

// Bio paragraphs — both Persian and English so the FA/EN toggle handles them.
const bio = [
  {
    fa: 'دارای مدرک کارشناسی صنایع‌دستی و کارشناسی‌ارشد پژوهش هنر از دانشگاه تهران هستم. تحصیلات دانشگاهی و تجربه حرفه‌ای من بر هنر ایران متمرکز است، با تخصصی ویژه در نگارگری.',
    en: 'I hold a Bachelor’s degree in Handicrafts and a Master’s degree in Art Research from the University of Tehran. My academic education and professional experience are centered on Iranian art, with a specialized focus on Persian miniature painting (Negargari).',
  },
  {
    fa: 'در کنار فعالیت در هنرهای سنتی، در حوزهٔ طراحی گرافیک نیز فعال هستم و دانش هنری خود را در بسترهای بصری و تجاری معاصر به کار می‌گیرم. این تخصص دوگانه به من امکان می‌دهد آثاری خلق کنم که هم ریشه در فرهنگ دارند و هم برای مخاطبان امروز جذاب و مرتبط هستند.',
    en: 'In parallel with my work in traditional arts, I am active in the field of graphic design, where I apply artistic knowledge to contemporary visual and commercial contexts. This dual expertise allows me to create works that are both culturally rooted and visually relevant to modern audiences.',
  },
  {
    fa: 'به‌عنوان هنرمندی چندرشته‌ای، به تلفیق نگارگری ایرانی، طراحی گرافیک، هوش مصنوعی (ComfyUI) و سوزن‌دوزی زرتشتی می‌پردازم. با ترکیب صنایع‌دستی سنتی با ابزارهای دیجیتال نوین، بیان‌های هنری نوآورانه‌ای را توسعه می‌دهم و در عین حال پیوند عمیقی با میراث فرهنگی ایران حفظ می‌کنم.',
    en: 'As a multidisciplinary artist, I explore the integration of Persian miniature painting, graphic design, artificial intelligence (ComfyUI), and Zoroastrian embroidery. By combining traditional craftsmanship with modern digital tools, I develop innovative artistic expressions while maintaining a strong connection to Iranian cultural heritage.',
  },
  {
    fa: 'کار من بر گسترش امکان‌های هنر ایرانی از طریق رویکرد میان‌رشته‌ای متمرکز است، تا این هنر هم در فضای داخلی و هم در عرصهٔ بین‌المللی قابل‌دسترس و معنادار باشد.',
    en: 'My work is focused on expanding the possibilities of Iranian art through interdisciplinary practice, making it accessible and meaningful in both local and international contexts.',
  },
];
---

<Layout
  title="دربارهٔ من — نگین خسرویانی"
  description="معرفی نگین خسرویانی، هنرمند چندرشته‌ای — نگارگری ایرانی، طراحی گرافیک و هوش مصنوعی."
>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(personJsonLd)} />
  <article class="about">
    <div class="about__content">
      <header class="about__header">
        <p class="about__eyebrow" data-fa="دربارهٔ من" data-en="About me">دربارهٔ من</p>
        <h1 class="about__name" data-fa="نگین خسرویانی" data-en="Negin Khosraviyani">نگین خسرویانی</h1>
      </header>

      <section class="about__statement" aria-label="معرفی">
        {bio.map((p) => (
          <p data-fa={p.fa} data-en={p.en}>{p.fa}</p>
        ))}
      </section>

      <nav class="about__work-links" aria-label="مشاهدهٔ آثار بر اساس بخش">
        <h2 class="about__section-label" data-fa="آثار" data-en="Works">آثار</h2>
        <ul class="about__list about__list--links">
          <li><a href={withBase('/ai/')}        data-fa="هوش مصنوعی"  data-en="AI">هوش مصنوعی</a></li>
          <li><a href={withBase('/motion/')}    data-fa="موشن گرافیک" data-en="Motion Graphics">موشن گرافیک</a></li>
          <li><a href={withBase('/graphic/')}   data-fa="گرافیک"      data-en="Graphic Design">گرافیک</a></li>
          <li><a href={withBase('/art/')}       data-fa="آثار هنری"   data-en="Artworks">آثار هنری</a></li>
          <li><a href={withBase('/exhibitions/')} data-fa="نمایشگاه"  data-en="Exhibitions">نمایشگاه</a></li>
          <li><a href={withBase('/honors/')}    data-fa="افتخارات"    data-en="Honors">افتخارات</a></li>
        </ul>
      </nav>
    </div>
  </article>
</Layout>

<style>
  .about {
    max-width: 44rem;
    padding-top: clamp(2rem, 6vh, 4rem);
    padding-bottom: 6rem;
  }
  .about__header { margin-bottom: clamp(2rem, 5vh, 3rem); }
  .about__eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    color: color-mix(in oklab, var(--ink) 55%, transparent);
    text-transform: uppercase;
  }
  .about__name {
    margin: 0;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 600;
    color: var(--ink);
  }

  .about__statement { margin-bottom: clamp(2.5rem, 6vh, 4rem); }
  .about__statement p {
    margin: 0 0 1.4em;
    font-size: clamp(1rem, 1.6vw, 1.08rem);
    line-height: 1.95;
    color: color-mix(in oklab, var(--ink) 82%, transparent);
    max-width: 38rem;
  }

  .about__section-label {
    margin: 0 0 1rem;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    color: color-mix(in oklab, var(--ink) 50%, transparent);
    font-weight: 500;
    text-transform: uppercase;
  }

  .about__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .about__list--links a {
    color: color-mix(in oklab, var(--ink) 78%, transparent);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in oklab, var(--ink) 22%, transparent);
    padding-bottom: 1px;
    transition: color 0.18s ease, border-color 0.18s ease;
  }
  .about__list--links a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* Switch to English typography rhythm in LTR mode */
  html[dir="ltr"] .about__statement p { text-align: left; }
  html[dir="rtl"] .about__statement p { text-align: right; }
</style>
