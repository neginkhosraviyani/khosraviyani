---
import Layout from "../../layouts/Layout.astro";
import { withBase } from '../../scripts/paths';
const subs = [
  { href: withBase('/graphic/illustration/'), title: 'تصویرسازی' },
  { href: withBase('/graphic/digital/'),      title: 'دیجیتال آرت' },
  { href: withBase('/graphic/book/'),         title: 'صفحه‌آرایی و جلد کتاب' },
];
---
<Layout title="گرافیک — نگین خسرویانی" description="بخش گرافیک: تصویرسازی، دیجیتال آرت، صفحه‌آرایی و جلد کتاب.">
  <section class="page-header"><h1 class="page-header__title">گرافیک</h1><p class="page-header__lede">یک زیربخش را انتخاب کنید</p></section>
  <div class="subgrid">
    {subs.map((s) => (<a class="subgrid__card" href={s.href}><h2 class="subgrid__card-title">{s.title}</h2></a>))}
  </div>
</Layout>
