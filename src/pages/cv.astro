---
// src/pages/cv.astro
import Layout from "../layouts/Layout.astro";
import { withBase } from "../scripts/paths";
---

<Layout
  title="رزومه — نگین خسرویانی"
  description="رزومهٔ هنری نگین خسرویانی."
>
  <article class="cv">
    <a href={withBase('/about/')} class="cv__back">→ دربارهٔ من</a>

    <header class="cv__header">
      <p class="cv__eyebrow">رزومه</p>
      <h1 class="cv__name">نگین خسرویانی</h1>
    </header>

    <p class="cv__placeholder">رزومهٔ کامل به‌زودی منتشر می‌شود.</p>
  </article>
</Layout>

<style>
  .cv {
    max-width: 44rem;
    padding-top: clamp(2rem, 6vh, 4rem);
    padding-bottom: 6rem;
  }

  .cv__back {
    display: inline-block;
    margin-bottom: 2rem;
    font-size: 0.86rem;
    color: color-mix(in oklab, #1B1B1B 50%, transparent);
    text-decoration: none;
  }
  .cv__back:hover { color: #1B1B1B; }

  .cv__header { margin-bottom: clamp(2rem, 5vh, 3rem); }
  .cv__eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    color: color-mix(in oklab, #1B1B1B 55%, transparent);
  }
  .cv__name {
    margin: 0;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 700;
    color: #1B1B1B;
  }

  .cv__placeholder {
    font-size: 1.05rem;
    line-height: 1.9;
    color: color-mix(in oklab, #1B1B1B 72%, transparent);
  }
</style>
