---
import Layout from "../../layouts/Layout.astro";
import { getAlbums, resolveAlbumMediaUrls } from '../../scripts/content';

const albumsRaw = getAlbums('motion');
const albums = await Promise.all(albumsRaw.map((a) => resolveAlbumMediaUrls('motion', a.slug, a)));

const allMedia = albums.flatMap((a) =>
  (a.placeholder?.enabled ? [] : a.media)
);
const isAllPlaceholder = albums.length > 0 && albums.every((a) => a.placeholder?.enabled);
---

<Layout title="موشن گرافیک — نگین خسرویانی" description="آثار موشن گرافیک نگین خسرویانی.">
  <section class="page-header"><h1 class="page-header__title">موشن گرافیک</h1></section>

  {isAllPlaceholder ? (
    <p class="project__placeholder">این مجموعه در دست تهیه است و به‌زودی منتشر می‌شود.</p>
  ) : (
    <div class="project__media">
      {allMedia.map((m: any) => m.type === 'image' ? (
        <figure class="project__figure">
          <picture>
            {m.webpSrc && <source type="image/webp" srcset={m.webpSrc} />}
            <img src={m.src} alt={m.alt ?? 'موشن گرافیک'} loading="lazy" decoding="async" />
          </picture>
          {m.caption && <figcaption>{m.caption}</figcaption>}
        </figure>
      ) : m.type === 'video' ? (
        <figure class="project__figure">
          <video controls preload="metadata" poster={m.poster}>
            {(m.sources ?? []).map((s: any) => (<source src={s.src} type={s.type} />))}
            {m.src && !m.sources?.length && <source src={m.src} />}
          </video>
          {m.caption && <figcaption>{m.caption}</figcaption>}
        </figure>
      ) : null)}
    </div>
  )}
</Layout>
