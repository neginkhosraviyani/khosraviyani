---

<Layout title="افتخارات — نگین خسرویانی" description="رزومه، تحصیلات، مقاله، نمایشگاه‌ها و سوابق حرفه‌ای نگین خسرویانی.">
  <section class="page-header">
    <h1 class="page-header__title">افتخارات</h1>
  </section>

  <article class="cv">
    {sections.map((sec) => (
      <section class="cv__section">
        <h2 class="cv__heading" data-fa={sec.fa} data-en={sec.en}>{sec.fa}</h2>
        <ul class="cv__list">
          {sec.rows.map((row) => (
            <li class="cv__row">
              <span class="cv__year">{row.year}</span>
              <span class="cv__entry" data-fa={row.fa} data-en={row.en}>{row.fa}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </article>
</Layout>

<style>
  .cv {
    max-width: 48rem;
    margin: 0 auto;
    padding-top: clamp(1rem, 3vh, 2rem);
  }
  .cv__section {
    margin-bottom: clamp(2.5rem, 5vh, 3.5rem);
  }
  .cv__heading {
    margin: 0 0 1.25rem;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--accent);
    border-bottom: 1px solid var(--hairline);
    padding-bottom: 0.6rem;
  }
  .cv__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .cv__row {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1rem;
    align-items: baseline;
    color: color-mix(in oklab, var(--ink) 88%, transparent);
    line-height: 1.75;
  }
  .cv__year {
    color: var(--muted);
    font-size: 0.88rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .cv__entry {
    font-size: 0.96rem;
  }

  @media (max-width: 640px) {
    .cv__row {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
    .cv__year { font-size: 0.82rem; }
  }
</style>
