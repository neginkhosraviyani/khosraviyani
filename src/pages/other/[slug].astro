---
// src/pages/other/[slug].astro
import Layout from "../../layouts/Layout.astro";
import { getAlbums, getAlbum, resolveAlbumMediaUrls } from '../../scripts/content';
import { withBase } from '../../scripts/paths';

export async function getStaticPaths() {
  return getAlbums('other').map((album) => ({
    params: { slug: album.slug },
    props: { albumSlug: album.slug },
  }));
}

const { slug } = Astro.params;
if (!slug) throw new Error("Missing slug");

const albumRaw = getAlbum('other', slug);
if (!albumRaw) throw new Error(`Album not found: ${slug}`);

const album = await resolveAlbumMediaUrls('other', slug, albumRaw);
const isPlaceholder = album.placeholder?.enabled;
const trimmed = (v?: string) => v?.trim() || undefined;
const displayDate =
  trimmed(album.placeholder?.year) ||
  trimmed(album.displayDate) ||
  trimmed(album.dateCreated) ||
  trimmed(album.date);

const firstImageSrc = album.media.find((m: any) => m.type === 'image' && m.src)?.src;
const ogImage = (!isPlaceholder && firstImageSrc && Astro.site)
  ? new URL(firstImageSrc, Astro.site).href
  : undefined;
---

<Layout title={`${album.title} — نگین خسرویانی`} description={album.description} ogImage={ogImage}>
  <article class="project">
    <header class="project__header">
      <h1 class="project__title">{album.title}</h1>
      {displayDate && <p class="project__date">{displayDate}</p>}
      {album.description && <p class="project__description">{album.description}</p>}
    </header>

    {isPlaceholder ? (
      <p class="project__placeholder">این مجموعه در دست تهیه است و به‌زودی منتشر می‌شود.</p>
    ) : (
      <div class="project__media">
        {album.media.map((m: any) => (
          m.type === 'image' ? (
            <figure class="project__figure">
              <picture>
                {m.webpSrc && <source type="image/webp" srcset={m.webpSrc} />}
                <img src={m.src} alt={m.alt ?? album.title} loading="lazy" decoding="async" />
              </picture>
              {m.caption && <figcaption>{m.caption}</figcaption>}
            </figure>
          ) : m.type === 'video' ? (
            <figure class="project__figure">
              <video controls preload="metadata" poster={m.poster}>
                {(m.sources ?? []).map((s: any) => (
                  <source src={s.src} type={s.type} />
                ))}
                {m.src && !m.sources?.length && <source src={m.src} />}
              </video>
              {m.caption && <figcaption>{m.caption}</figcaption>}
            </figure>
          ) : null
        ))}
      </div>
    )}

    <footer class="project__footer">
      <a href={withBase("/other/")} class="project__back">→ بازگشت به سایر</a>
    </footer>
  </article>
</Layout>

<style>
  .project { max-width: 56rem; margin: 0 auto; padding-top: clamp(1.5rem, 4vh, 3rem); }
  .project__header { text-align: center; margin-bottom: clamp(2rem, 5vh, 3.5rem); }
  .project__title { margin: 0; font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 500; }
  .project__date { margin: 0.4rem 0 0; color: var(--muted); font-size: 0.95rem; }
  .project__description { margin: 1.25rem auto 0; max-width: 36rem; color: var(--muted); line-height: 1.8; }
  .project__placeholder { text-align: center; color: var(--muted); padding: 3rem 0; font-size: 1rem; }
  .project__media { display: flex; flex-direction: column; gap: clamp(2rem, 5vh, 3.5rem); }
  .project__figure { margin: 0; }
  .project__figure img, .project__figure video { width: 100%; height: auto; display: block; }
  .project__figure figcaption { margin-top: 0.75rem; text-align: center; color: var(--muted); font-size: 0.9rem; }
  .project__footer { margin-top: clamp(3rem, 8vh, 5rem); padding-top: 1.5rem; border-top: 1px solid var(--hairline); text-align: center; }
  .project__back { color: var(--muted); text-decoration: none; font-size: 0.95rem; }
  .project__back:hover { color: var(--ink); }
</style>
