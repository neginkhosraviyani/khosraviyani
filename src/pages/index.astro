---
// src/pages/index.astro — home page with combined gallery of all sections
import Layout from "../layouts/Layout.astro";
import { getAlbums, resolveAlbumMediaUrls } from "../scripts/content";
import { withBase } from "../scripts/paths";
import type { Section } from "../scripts/content";

const sections: { section: Section; label: string; hrefBase: string }[] = [
  { section: "ai",                    label: "هوش مصنوعی",         hrefBase: withBase("/ai/") },
  { section: "motion",                label: "موشن گرافیک",         hrefBase: withBase("/motion/") },
  { section: "graphic-illustration",  label: "تصویرسازی",           hrefBase: withBase("/graphic/illustration/") },
  { section: "graphic-digital",       label: "دیجیتال آرت",         hrefBase: withBase("/graphic/digital/") },
  { section: "graphic-book",          label: "صفحه‌آرایی و جلد کتاب", hrefBase: withBase("/graphic/book/") },
  { section: "art-negargari",         label: "نگارگری",            hrefBase: withBase("/art/negargari/") },
  { section: "art-golomorgh",         label: "گل و مرغ",            hrefBase: withBase("/art/gol-o-morgh/") },
  { section: "art-tazhib",            label: "تذهیب",              hrefBase: withBase("/art/tazhib/") },
  { section: "exhibition-dafineh",    label: "موزه دفینه تهران",     hrefBase: withBase("/exhibitions/dafineh/") },
  { section: "exhibition-rezaabbasi", label: "موزه رضا عباسی تهران", hrefBase: withBase("/exhibitions/reza-abbasi/") },
];

type Entry = { href: string; title: string; cover?: string; coverWebp?: string; sectionLabel: string; year?: string };
const entries: Entry[] = [];
for (const { section, label, hrefBase } of sections) {
  const raw = getAlbums(section);
  const resolved = await Promise.all(
    raw.map((album) => resolveAlbumMediaUrls(section, album.slug, album, { coverOnly: true }))
  );
  for (const album of resolved) {
    entries.push({
      href: `${hrefBase}${album.slug}/`,
      title: album.title,
      cover: album.cover,
      coverWebp: album.coverWebp,
      sectionLabel: label,
      year: album.placeholder?.year ?? album.displayDate,
    });
  }
}
---

<Layout>
  <section class="page-header">
    <h1 class="page-header__title">نگین خسرویانی</h1>
    <p class="page-header__lede">هنرمند — هوش مصنوعی، موشن گرافیک، گرافیک و آثار سنتی</p>
  </section>

  <div class="gallery">
    {entries.map((e) => (
      <a class="gallery__item" href={e.href}>
        <div class="gallery__thumb-wrap">
          {e.cover && (
            <picture>
              {e.coverWebp && <source type="image/webp" srcset={e.coverWebp} />}
              <img class="gallery__thumb" src={e.cover} alt={e.title} loading="lazy" decoding="async" />
            </picture>
          )}
        </div>
        <h2 class="gallery__title">{e.title}</h2>
        <p class="gallery__caption">{e.sectionLabel}{e.year ? ` — ${e.year}` : ''}</p>
      </a>
    ))}
  </div>
</Layout>
