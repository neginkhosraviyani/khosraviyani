---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import { getAlbums, resolveAlbumMediaUrls } from "../scripts/content";
import { withBase } from "../scripts/paths";
import type { Section } from "../scripts/content";

const sections: { section: Section; label: string; href: string }[] = [
  { section: "ai",        label: "هوش مصنوعی",        href: withBase("/ai/") },
  { section: "miniature", label: "نگارگری و گل و مرغ", href: withBase("/miniature/") },
  { section: "graphic",   label: "گرافیک",            href: withBase("/graphic/") },
  { section: "other",     label: "سایر",              href: withBase("/other/") },
];

type Entry = {
  href: string;
  title: string;
  cover?: string;
  coverWebp?: string;
  sectionLabel: string;
  year?: string;
};

const entries: Entry[] = [];
for (const { section, label, href: sectionHref } of sections) {
  const raw = getAlbums(section);
  const resolved = await Promise.all(
    raw.map((album) => resolveAlbumMediaUrls(section, album.slug, album, { coverOnly: true }))
  );
  for (const album of resolved) {
    entries.push({
      href: `${sectionHref}${album.slug}/`,
      title: album.title,
      cover: album.cover,
      coverWebp: album.coverWebp,
      sectionLabel: label,
      year: album.placeholder?.year ?? album.displayDate,
    });
  }
}
---

<Layout>
  <section class="page-header">
    <h1 class="page-header__title">نگین خسرویانی</h1>
    <p class="page-header__lede">آثار هنری — هوش مصنوعی، نگارگری، گرافیک</p>
  </section>

  <div class="gallery">
    {entries.map((e) => (
      <a class="gallery__item" href={e.href}>
        <div class="gallery__thumb-wrap">
          {e.cover && (
            <picture>
              {e.coverWebp && <source type="image/webp" srcset={e.coverWebp} />}
              <img
                class="gallery__thumb"
                src={e.cover}
                alt={e.title}
                loading="lazy"
                decoding="async"
              />
            </picture>
          )}
        </div>
        <h2 class="gallery__title">{e.title}</h2>
        <p class="gallery__caption">{e.sectionLabel}{e.year ? ` — ${e.year}` : ''}</p>
      </a>
    ))}
  </div>
</Layout>
